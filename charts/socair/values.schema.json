{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Socair chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "size": { "type": "string", "minLength": 1 },
        "keep": { "type": "boolean" },
        "annotations": { "type": "object" }
      }
    },
    "scratch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": { "type": "string" },
        "ephemeral": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "storageClass": { "type": "string" },
            "size": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "pull": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string", "pattern": "^(https?://.+)?$" },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "egressCIDRs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustedKeysConfigMap": { "type": "string" },
        "acceptorKeysConfigMap": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "authenticatingProxy": { "type": "boolean" },
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "signoff": "defilantech-release[bot] <342599757+defilantech-release[bot]@users.noreply.github.com>",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Merging this pull request tags v${version} and creates its draft release. The tag starts `release.yml`, which builds, attests, and attaches the assets; publishing the draft is the maintainer's step (docs/releasing.md).",
  "packages": {
    ".": {
      "component": "",
      "changelog-path": "CHANGELOG.md",
      "draft": true,
      "force-tag-creation": true,
      "prerelease": true,
      "versioning": "prerelease",
      "prerelease-type": "rc",
      "extra-files": [
        { "type": "generic", "path": "charts/socair/Chart.yaml" },
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "docs/kubernetes.md" },
        { "type": "generic", "path": "docs/verify-release.md" }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true }
  ]
}
